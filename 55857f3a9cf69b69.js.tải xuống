      opacity: 0;
      filter: blur(2px);
      transform: translateY(calc(100%));
    }
    100% {
      opacity: 1;
      filter: blur(0);
      transform: translateY(calc(100% + 12px));
    }
  }

  @keyframes ring-fade {
    0% {
      opacity: 0;
      transform: scale(0.95);
    }
